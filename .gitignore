lazy-lock.json
.zcompdump
zsh_plugins.zsh
.zsh_history
.luarc.json
.zcompcache

*.egg-info/  # Ignore Python egg-info directories
*.target.wants

# Machine-local secrets (never commit)
.secrets/

# Pi — secrets & ephemeral
dot-pi/agent/auth.json
dot-pi/agent/mcp-cache.json
dot-pi/agent/sessions/
dot-pi/context-mode/
# CocoIndex Code (ccc)
/.cocoindex_code/*
!/.cocoindex_code/global_settings.yml

# Claude Code — allowlist: ignore everything under .claude/, re-include only
# known-safe durable config. Keeps secrets (.credentials.json, session-env/,
# shell-snapshots/) and ephemeral state (projects/, sessions/, history) out.
dot-claude/*
!dot-claude/settings.json
!dot-claude/skills/
!dot-claude/agents/
!dot-claude/commands/
!dot-claude/hooks/
!dot-claude/output-styles/
!dot-claude/CLAUDE.md
# settings.local.json stays machine-local (also ignored via ~/.config/git/ignore)
dot-claude/settings.local.json
# Account/MCP/history blob at $HOME — never commit
/.claude.json
/.claude.json.backup*

# Git identity — user/machine-specific, kept out of the public repo.
# Copy the *.example templates and fill in locally; git silently skips
# missing include paths, so absence is harmless.
dot-config/git/priv.conf
dot-config/git/work.conf
dot-config/git/allowed_signers

# Yazi plugins/flavors are managed by `ya pkg` from package.toml (pinned
# rev+hash), not vendored. Only package.toml is tracked; contents regenerate.
dot-config/yazi##exe.yazi/plugins/
dot-config/yazi##exe.yazi/flavors/

# herdr — allowlist: config.toml is the only durable config. herdr 0.8.0 pins
# its runtime files to the config dir with no separate state-dir setting, so
# logs (herdr-{server,client}.log), sockets (*.sock), restore state
# (session.json, session-history.json) and .plugins.lock can all appear here.
# They are machine-local and can contain pane scrollback — never commit them.
dot-config/herdr/*
!dot-config/herdr/config.toml

# Typst local packages — sources are tracked, compiled proofs are not.
dot-local/share/typst/packages/**/*.pdf
