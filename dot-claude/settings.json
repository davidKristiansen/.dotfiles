{
  "permissions": {
    "allow": [
      "mcp__mcpipe__*",
      "mcp__graphify__*",
      "Bash(mcpipe *)",
      "Bash(graphify *)",
      "Bash(pipx *)",
      "Bash(mise *)",
      "Read(~/.dotfiles/**)",
      "Read(~/.local/bin/**)",
      "Edit(~/.dotfiles/**)"
    ],
    "additionalDirectories": [
      "~/.dotfiles",
      "~/.local/bin"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; exec node \"$HOME/.claude/hooks/require-explicit-model.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
