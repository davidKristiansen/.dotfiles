#!/usr/bin/env bash
# teams-url-dispatch — route Microsoft Teams deep links into teams-for-linux,
# and send every other URL to the real browser.
#
# Teams deep links look like:
#   https://teams.microsoft.com/l/message/19:...@thread.tacv2/175...?tenantId=...
#   msteams:/l/message/...            (v1 protocol)
#   msteams://teams.microsoft.com/... (v2 protocol)
#
# teams-for-linux registers itself as the `msteams:` protocol client and its
# processArgs() navigates the running window for the v1/v2 msteams forms
# (message / channel / chat / meetup-join / ...). A raw https deep link is only
# accepted for meetup-join, so for everything else we rewrite the scheme to
# `msteams://` (the v2 form), which the app converts back to https internally.
#
# Used as:
#   * teams-for-linux "defaultURLHandler" (in-app external link clicks)
#   * the x-scheme-handler/msteams handler (Firefox / xdg-open msteams: links)
set -euo pipefail

url="${1:-}"
[ -z "$url" ] && exit 0

# Resolved via PATH (no absolute paths): teams-for-linux lives in a system bin
# dir, and this script lives in $XDG_BIN_HOME, both on the session PATH.
TEAMS_BIN="teams-for-linux"
TEAMS_ARGS=(--ozone-platform=x11)
BROWSER_FALLBACK="firefox"

# Teams hosts the app can navigate to (mirrors msTeamsProtocols v2).
teams_host_re='^teams\.(microsoft\.com|live\.com|cloud\.microsoft)$'
# Deep-link path prefixes the app understands (mirrors msTeamsProtocols v1/v2).
teams_path_re='^/(meet/|l/(app|call|channel|chat|entity|file|meeting|meetup-join|message|task|team)/)'

open_in_app() {
    # teams-for-linux resolves the relative "customCSSLocation" against its
    # working directory, so a cold start must begin in $HOME.
    cd "$HOME"
    # teams-for-linux holds a single-instance lock: this either starts the app
    # or forwards the URL to the already-running window via second-instance.
    exec "$TEAMS_BIN" "${TEAMS_ARGS[@]}" "$1"
}

open_in_browser() {
    exec "$BROWSER_FALLBACK" "$1"
}

case "$url" in
    msteams:*)
        open_in_app "$url"
        ;;
    http://* | https://*)
        rest="${url#*://}"       # teams.microsoft.com/l/message/...
        host="${rest%%/*}"       # teams.microsoft.com
        if [[ "$rest" == */* ]]; then
            path="/${rest#*/}"   # /l/message/...
        else
            path="/"
        fi
        if [[ "$host" =~ $teams_host_re && "$path" =~ $teams_path_re ]]; then
            open_in_app "msteams://${rest}"
        else
            open_in_browser "$url"
        fi
        ;;
    *)
        open_in_browser "$url"
        ;;
esac
